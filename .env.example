# Origin of the MailPulse API — scheme, host and port, no trailing slash and no
# /api suffix (the client appends the paths from the spec).
#
# This origin must appear in the backend's WEB_CORS_ORIGINS, and the dev server
# must run on the port listed there. The backend ships with
# WEB_CORS_ORIGINS=http://localhost:5173, which matches vite.config.ts.
VITE_API_BASE_URL=http://localhost:3000
